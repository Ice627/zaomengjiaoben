<窗口
	宽度="650"
	高度="750"
	显示确认按钮="true"
	显示标题栏="true"
	标题="综合自动化配置台"
	配置文件="test.config"
	标签头字体大小="16"
	标签头选中字体颜色="#ff007aff"
	标签头字体默认颜色="#ff888888">
<标签页 标题="自定义连招">
		<垂直布局 宽度="-2" 高度="-1" 边距="15,5,15,5">
			<!-- 1. 连招配置 -->
			<文本框 默认值="连招配置" 文字颜色="#FF3B72C4" 文字大小="14" 高度="-2"/>
			<水平布局 宽度="-2" 高度="-2">
				<文本框 默认值="选择预设：" 文字大小="12" 高度="50"/>
				<下拉框 id="cfg_slot_select" 默认值="0" 宽度="-2" 文字大小="10" 高度="-1">
					<选项 文本="槽位1" 文字大小="12"/>
					<选项 文本="槽位2" 文字大小="12"/>
					<选项 文本="槽位3" 文字大小="12"/>
					<选项 文本="槽位4" 文字大小="12"/>
					<选项 文本="槽位5" 文字大小="12"/>
				</下拉框>
			</水平布局>
			<水平布局 宽度="-2" 高度="-2" 边距="0,5,0,0">
				<按钮 id="btn_save_preset" 标题="保存" 宽度="-2" 文字大小="12" 高度="-2" 边距="2,0,2,0"/>
				<按钮 id="btn_load_preset" 标题="加载" 宽度="-2" 文字大小="12" 高度="-2" 边距="2,0,2,0"/>
				<按钮 id="btn_del_preset" 标题="删除" 宽度="-2" 文字大小="12" 高度="-2" 边距="2,0,2,0"/>
			</水平布局>
			<文本框 默认值="--------------------------------------------------" 文字颜色="#FFE0E0E0" 高度="-2" 对齐="居中"/>
			<!-- 2. 用户自定义：场景起手移动 -->
			<文本框 默认值="用户自定义：场景起手移动" 文字颜色="#FF3B72C4" 文字大小="14" 高度="-2"/>
			<水平布局 宽度="-2" 高度="-2">
				<文本框 默认值="移动方式：" 文字大小="12" 高度="50"/>
				<下拉框 id="cfg_move_type" 默认值="0" 宽度="-2" 文字大小="12" 高度="-1">
					<选项 文本="长按右移" 文字大小="12"/>
					<选项 文本="技能右移" 文字大小="12"/>
				</下拉框>
			</水平布局>
			<水平布局 宽度="-2" 高度="-2" 边距="0,5,0,0">
				<文本框 默认值="长按按键：" 文字大小="12" 高度="50"/>
				<下拉框 id="cfg_long_press_key" 默认值="0" 宽度="-2" 文字大小="12" 高度="-1">
					<选项 文本="右移" 文字大小="12"/>
					<选项 文本="技能1" 文字大小="12"/>
					<选项 文本="技能2" 文字大小="12"/>
					<选项 文本="技能3" 文字大小="12"/>
					<选项 文本="技能4" 文字大小="12"/>
					<文本框 默认值="场景1:" 文字颜色="#ffff0000" 文字大小="12" 高度="-2"/>
					<输入框 id="cfg_scene1_val1" 默认值="0" 宽度="-2" 文字大小="12" 高度="-2"/>
					<文本框 默认值=" 场景2:" 文字颜色="#ffff0000" 文字大小="12" 高度="-2"/>
					<输入框 id="cfg_scene2_val1" 默认值="0" 宽度="-2" 文字大小="12" 高度="-2"/>
					<文本框 默认值=" 场景3:" 文字颜色="#ffff0000" 文字大小="12" 高度="-2"/>
					<输入框 id="cfg_scene3_val1" 默认值="0" 宽度="-2" 文字大小="12" 高度="-2"/>
				</下拉框>
			</水平布局>
			<水平布局 宽度="-2" 高度="-2" 边距="0,5,0,0">
			</水平布局>
			<水平布局 宽度="-2" 高度="-2" 边距="0,5,0,0">
				<文本框 默认值="技能：" 文字大小="12" 高度="50"/>
				<下拉框 id="cfg_skill_choice" 默认值="0" 宽度="-2" 文字大小="12" 高度="-1">
					<选项 文本="普攻" 文字大小="12"/>
					<选项 文本="技能1" 文字大小="12"/>
					<选项 文本="技能2" 文字大小="12"/>
					<选项 文本="技能3" 文字大小="12"/>
					<选项 文本="技能4" 文字大小="12"/>
				</下拉框>
				<文本框 默认值="场景1：" 文字颜色="#ffff0000" 文字大小="12" 高度="-2"/>
				<文本框 默认值="次数" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_s1_count" 默认值="" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值=" 间隔" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_s1_interval" 默认值="130" 宽度="45" 文字大小="12" 高度="-2"/>
				<文本框 默认值=" 场景2：" 文字颜色="#ffff0000" 文字大小="12" 高度="-2"/>
        <文本框 默认值="次数" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_s2_count" 默认值="4" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="间隔" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_s2_interval" 默认值="130" 宽度="45" 文字大小="12" 高度="-2"/>
				<文本框 默认值=" 场景3:" 文字颜色="#ffff0000" 文字大小="12" 高度="-2"/>
        <文本框 默认值="次数" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_s3_count" 默认值="4" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值=" 间隔" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_s3_interval" 默认值="130" 宽度="45" 文字大小="12" 高度="-2"/>
			</水平布局>
			
			<水平布局 宽度="-2" 高度="-2" 边距="0,5,0,0">
			</水平布局>
			<文本框 默认值="--------------------------------------------------" 文字颜色="#FFE0E0E0" 高度="-2" 对齐="居中"/>
			<!-- 3. 回头 -->
			<文本框 默认值="回头" 文字颜色="#FF3B72C4" 文字大小="14" 高度="-2"/>
			<水平布局 宽度="-2" 高度="-2">
				<文本框 默认值="场景1" 文字颜色="#ffff0000" 文字大小="12" 高度="-2"/>
				<多选框 id="cfg_turn_s1_enable" 文本="启用" 选中="false" 文字大小="12" 高度="-2"/>
				<文本框 默认值="延时:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_turn_s1_delay" 默认值="0" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="次数:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_turn_s1_count" 默认值="3" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="间隔:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_turn_s1_interval" 默认值="60" 宽度="-2" 文字大小="12" 高度="-2"/>
			</水平布局>
			<水平布局 宽度="-2" 高度="-2" 边距="0,5,0,0">
				<文本框 默认值="场景2" 文字颜色="#ffff0000" 文字大小="12" 高度="-2"/>
				<多选框 id="cfg_turn_s2_enable" 文本="启用" 选中="false" 文字大小="12" 高度="-2"/>
				<文本框 默认值="延时:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_turn_s2_delay" 默认值="0" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="次数:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_turn_s2_count" 默认值="3" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="间隔:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_turn_s2_interval" 默认值="60" 宽度="-2" 文字大小="12" 高度="-2"/>
			</水平布局>
			<水平布局 宽度="-2" 高度="-2" 边距="0,5,0,0">
				<文本框 默认值="场景3" 文字颜色="#ffff0000" 文字大小="12" 高度="-2"/>
				<多选框 id="cfg_turn_s3_enable" 文本="启用" 选中="false" 文字大小="12" 高度="-2"/>
				<文本框 默认值="延时:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_turn_s3_delay" 默认值="0" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="次数:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_turn_s3_count" 默认值="3" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="间隔:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_turn_s3_interval" 默认值="60" 宽度="-2" 文字大小="12" 高度="-2"/>
			</水平布局>
			<文本框 默认值="--------------------------------------------------" 文字颜色="#FFE0E0E0" 高度="-2" 对齐="居中"/>
			<!-- 4. 昆仑山专属设置 -->
			<文本框 默认值="昆仑山专属设置" 文字颜色="#FF3B72C4" 文字大小="14" 高度="-2"/>
			<水平布局 宽度="-2" 高度="-2">
				<文本框 默认值="彩蛋频率:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_kls_freq" 默认值="50" 宽度="45" 文字大小="12" 高度="-2"/>
				<文本框 默认值="ms" 文字大小="12" 高度="-2"/>
				<多选框 id="cfg_kls_normal_att" 文本="场景2插入普攻" 选中="false" 文字大小="12" 高度="-2"/>
			</水平布局>
			<文本框 默认值="--------------------------------------------------" 文字颜色="#FFE0E0E0" 高度="-2" 对齐="居中"/>
			<!-- 5. 循环技能段 -->
			<文本框 默认值="循环技能段" 文字颜色="#FF3B72C4" 文字大小="14" 高度="-2"/>
			<水平布局 宽度="-2" 高度="-2">
				<文本框 默认值="技能1：" 文字大小="12" 高度="50"/>
				<下拉框 id="cfg_loop_skill1" 默认值="0" 宽度="-2" 文字大小="12" 高度="-1">
					<选项 文本="不执行" 文字大小="12" 宽度="-2"/>
				</下拉框>
				<文本框 默认值="次数:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_loop_count1" 默认值="1" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="间隔:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_loop_interval1" 默认值="300" 宽度="45" 文字大小="12" 高度="-2"/>
				<文本框 默认值="ms" 文字大小="12" 高度="-2"/>
			</水平布局>
			<水平布局 宽度="-2" 高度="-2" 边距="0,5,0,0">
				<文本框 默认值="技能2：" 文字大小="12" 高度="50"/>
				<下拉框 id="cfg_loop_skill2" 默认值="0" 宽度="-2" 文字大小="12" 高度="-1">
					<选项 文本="不执行" 文字大小="12" 宽度="-2"/>
				</下拉框>
				<文本框 默认值="次数:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_loop_count2" 默认值="1" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="间隔:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_loop_interval2" 默认值="300" 宽度="45" 文字大小="12" 高度="-2"/>
				<文本框 默认值="ms" 文字大小="12" 高度="-2"/>
			</水平布局>
			<水平布局 宽度="-2" 高度="-2" 边距="0,5,0,0">
				<文本框 默认值="技能3：" 文字大小="12" 高度="50"/>
				<下拉框 id="cfg_loop_skill3" 默认值="0" 宽度="-2" 文字大小="12" 高度="-1">
					<选项 文本="不执行" 文字大小="12" 宽度="-2"/>
				</下拉框>
				<文本框 默认值="次数:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_loop_count3" 默认值="1" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="间隔:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_loop_interval3" 默认值="300" 宽度="45" 文字大小="12" 高度="-2"/>
				<文本框 默认值="ms" 文字大小="12" 高度="-2"/>
			</水平布局>
			<水平布局 宽度="-2" 高度="-2" 边距="0,5,0,0">
				<文本框 默认值="技能4：" 文字大小="12" 高度="50"/>
				<下拉框 id="cfg_loop_skill4" 默认值="0" 宽度="-2" 文字大小="12" 高度="-1">
					<选项 文本="不执行" 文字大小="12" 宽度="-2"/>
				</下拉框>
				<文本框 默认值="次数:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_loop_count4" 默认值="1" 宽度="-2" 文字大小="12" 高度="-2"/>
				<文本框 默认值="间隔:" 文字大小="12" 高度="-2"/>
				<输入框 id="cfg_loop_interval4" 默认值="300" 宽度="45" 文字大小="12" 高度="-2"/>
				<文本框 默认值="ms" 文字大小="12" 高度="-2"/>
			</水平布局>
			<!-- 底部四个自定义蓝色按钮 -->
			<水平布局 宽度="-1" 高度="-2" 对齐="居中" 边距="0,30,0,0">
				<按钮 id="btn_exit" 标题="退出" 宽度="-1" 权重="1" 文字大小="12" 高度="-2" 边距="10,0,10,0"/>
				<按钮 id="btn_minimize" 标题="最小化" 宽度="-1" 权重="1" 文字大小="12" 高度="-2" 边距="10,0,10,0"/>
				<按钮 id="btn_save" 标题="保存" 宽度="-1" 权重="1" 文字大小="12" 高度="-2" 边距="10,0,10,0"/>
				<按钮 id="btn_continue" 标题="开始" 宽度="-1" 权重="1" 文字大小="12" 高度="-2" 边距="10,0,10,0"/>
			</水平布局>
		</垂直布局>
	</标签页>
</窗口>