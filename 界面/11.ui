<窗口
	宽度="650"
	高度="750"
	显示确认按钮="true"
	显示标题栏="true"
	标题="综合自动化配置台"
	配置文件="test.config"
	标签头字体大小="16"
	标签头选中字体颜色="#ff007aff"
	标签头字体默认颜色="#ff888888">
	<标签页 标题="自定义连招">
		<垂直布局 宽度="-2" 高度="-1" 边距="15,5,15,5">
			<!-- 1. 蛋选择 -->
			<文本框 默认值="蹲蛋设置" 文字颜色="#FF3B72C4" 文字大小="14" 高度="-2"/>
			<水平布局 宽度="-2" 高度="-2">
				<文本框 默认值="选择预设：" 文字大小="12" 高度="50"/>
				<下拉框 id="蛋战力" 默认值="0" 宽度="-2" 文字大小="10" 高度="-1">
					<选项 文本="不限" 文字大小="12"/>
					<选项 文本="170W" 文字大小="12"/>
					<选项 文本="120W" 文字大小="12"/>
					<选项 文本="100W" 文字大小="12"/>
					<选项 文本="80W" 文字大小="12"/>
					<选项 文本="60W" 文字大小="12"/>
					<选项 文本="40W" 文字大小="12"/>
				</下拉框>
			</水平布局>

		</垂直布局>
	</标签页>
</窗口>